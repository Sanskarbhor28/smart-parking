# Copy this file to ".env" and edit. NEVER commit ".env".

# --- Database ---
# Local development (default, no setup needed):
DATABASE_URL=sqlite:///./data/smart_parking.db
# PostgreSQL (local Docker or AWS RDS). Replace the placeholders:
# DATABASE_URL=postgresql+psycopg2://parking_user:CHANGE_ME@localhost:5432/smart_parking

# --- Parking lot ---
TOTAL_SLOTS=30

# --- ML ---
MODEL_DIR=ml/models

# --- Dashboard / simulator talk to the API here ---
API_URL=http://localhost:8000

# --- Only for docker-compose (PostgreSQL container) ---
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=smart_parking
